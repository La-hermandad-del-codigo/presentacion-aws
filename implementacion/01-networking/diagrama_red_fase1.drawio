        <mxCell id="ec2-priv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;EC2 Test de Red Privada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#78350F&quot;&gt;• &lt;b&gt;Tipo:&lt;/b&gt; t4g.nano / t3.nano&lt;br&gt;• &lt;b&gt;IP Privada:&lt;/b&gt; 10.0.10.X (Sin IP Pública)&lt;br&gt;• &lt;b&gt;Security Group:&lt;/b&gt; Allow Inbound HTTP :8080 &lt;u&gt;SOLO&lt;/u&gt; desde el SG de la EC2 Pública&lt;br&gt;• &lt;b&gt;Servicio:&lt;/b&gt; Micro-web en Python/Nginx que retorna confirmación de aislamiento y conectividad este-oeste.&lt;/font&gt;" vertex="1">
          <mxGeometry height="145" width="380" x="145" y="725" as="geometry" />
        </mxCell>
