        <mxCell id="ec2-pub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;EC2 Test de Red Pública (t4g.nano / t3.nano)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#0369A1&quot;&gt;• &lt;b&gt;IP Pública Dinámica:&lt;/b&gt; Accesible desde Internet vía puerto 80&lt;br&gt;• &lt;b&gt;IP Privada:&lt;/b&gt; 10.0.1.X &amp;nbsp;|&amp;nbsp; &lt;b&gt;Security Group:&lt;/b&gt; Allow Inbound HTTP :80 desde 0.0.0.0/0&lt;br&gt;• &lt;b&gt;Función:&lt;/b&gt; Servidor Web de diagnóstico + Ejecutor de curl hacia la Subred Privada&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="580" x="150" y="470" as="geometry" />
