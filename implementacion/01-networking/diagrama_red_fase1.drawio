        <mxCell id="ext-note-block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px;&quot; color=&quot;#B91C1C&quot;&gt;Demostración de Aislamiento Negativo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#7F1D1D&quot;&gt;El acceso directo desde Internet a la IP privada falla por diseño (Timeout).&lt;br&gt;Esto prueba que la subred privada NO tiene exposición perimetral.&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="460" x="440" y="110" as="geometry" />
        </mxCell>
        <mxCell id="panel-legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;Criterios de Verificación de Red&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#334155&quot;&gt;• &lt;b&gt;1. Ingress Público:&lt;/b&gt; HTTP :80 accesible vía IGW.&lt;br&gt;• &lt;b&gt;2. Este-Oeste:&lt;/b&gt; Subnet pública consulta a privada vía :8080.&lt;br&gt;• &lt;b&gt;3. Capa Aislada:&lt;/b&gt; Solo responde al puerto PostgreSQL :5432.&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="510" x="930" y="110" as="geometry" />
        </mxCell>
