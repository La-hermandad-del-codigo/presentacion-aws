        <mxCell id="igw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2.5;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Internet Gateway (IGW)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569&quot;&gt;Nombre: &lt;code&gt;apm-sofi-prod-igw&lt;/code&gt; · Puerta de Enlace pública hacia Internet&lt;/font&gt;" vertex="1">
