        <mxCell id="ext-browser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Profesor / Alumno / Evaluador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#1E293B&quot;&gt;Navegador Web / Terminal externa desde casa&lt;/font&gt;" vertex="1">
