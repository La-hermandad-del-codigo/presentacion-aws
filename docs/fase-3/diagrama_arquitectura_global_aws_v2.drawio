        <mxCell id="alb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Application Load Balancer (ALB) · Multi-AZ Ingress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#0369a1&quot;&gt;Terminación HTTPS :443 · Redirección HTTP-to-HTTPS automática · Health Checks de salud periódicos&lt;br&gt;&lt;b&gt;Host &amp;amp; Path Routing:&lt;/b&gt; / hacia Next.js · /api hacia NestJS · *.reflexoperu / *.arteideas hacia Clientes&lt;/font&gt;" vertex="1">
