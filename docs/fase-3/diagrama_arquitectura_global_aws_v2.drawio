        <mxCell id="video-step-control" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;1. Control Plane: Solicitud Ligera de Ubicación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#5B21B6&quot;&gt;• &lt;b&gt;Petición API:&lt;/b&gt; Cliente solicita video a &lt;code&gt;sofi-backend&lt;/code&gt; vía ALB (&lt;code&gt;/api/videos/:id&lt;/code&gt;)&lt;br&gt;• &lt;b&gt;Respuesta &amp;lt; 1 KB:&lt;/b&gt; Backend valida sesión en RDS y devuelve solo la URL directa de CloudFront&lt;br&gt;• &lt;b&gt;Cero Proxy:&lt;/b&gt; &lt;u&gt;Fargate NUNCA transmite bytes de video ni satura memoria RAM&lt;/u&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="450" x="1515" y="85" as="geometry" />
        </mxCell>
