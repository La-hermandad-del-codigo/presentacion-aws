          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="video-step-data" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;2. Data Plane: Streaming Directo desde el Borde&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#5B21B6&quot;&gt;• &lt;b&gt;Streaming CDN:&lt;/b&gt; Reproductor web solicita y reproduce directo desde &lt;b&gt;Amazon CloudFront (CDN Edge)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Origen Seguro:&lt;/b&gt; CloudFront entrega desde Edge Cache y recupera de &lt;b&gt;Amazon S3 vía OAC&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Ahorro FinOps:&lt;/b&gt; Tareas Fargate 100% libres de sockets pesados y &lt;b&gt;$0 en NAT Gateway&lt;/b&gt; ($0.045/GB)&lt;/font&gt;" vertex="1">
