        <mxCell id="task-clientes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=1.8;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;Clientes B2B Desacoplados&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#6b21a8&quot;&gt;Reflexo Perú &amp;amp; Arte y Ideas&lt;br&gt;&lt;b&gt;0.50 vCPU / 1024 MiB RAM&lt;/b&gt;&lt;br&gt;Aislamiento de tráfico comercial&lt;/font&gt;" vertex="1">
