        <mxCell id="video-flow-panel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#7C3AED;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=20;spacingTop=16;fontFamily=Helvetica;fontColor=#5B21B6;" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;Flujo de Streaming de Video Desacoplado (Direct-to-Client)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11.5px;&quot; color=&quot;#6D28D9&quot;&gt;&lt;i&gt;Estrategia Anti-Saturación: Control Plane Ligero + CDN Edge Offloading&lt;/i&gt;&lt;/font&gt;" vertex="1">
