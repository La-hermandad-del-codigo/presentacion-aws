        <mxCell id="task-bot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.8;fontFamily=Helvetica;shadow=1;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;Bot-Asistencia-APM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#4338ca&quot;&gt;Node.js Discord WebSocket&lt;br&gt;&lt;b&gt;0.25 vCPU / 512 MiB RAM&lt;/b&gt;&lt;br&gt;Socket continuo 24/7 sin timeout&lt;/font&gt;" vertex="1">
